/* Cloudflare Workers: static assets + 1 room Durable Object */
{
  "name": "lakeside-fishing",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/ws"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "MultiplayerRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MultiplayerRoom"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
